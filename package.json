{
  "name": "react-native-color-library",
  "version": "1.1.0",
  "description": "TypeScript-first color, gradient, and theming library for React Native — ThemeProvider, design tokens, presets, a11y audit, Skia gradients, dynamic color, CLI, and more.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "bin": {
    "rn-color": "./cli/rn-color.js"
  },
  "files": [
    "dist",
    "cli",
    "example/App.tsx",
    "example/README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "react-native",
    "colors",
    "color",
    "palette",
    "gradient",
    "gradients",
    "theme",
    "theming",
    "design-system",
    "tailwind",
    "material",
    "typescript",
    "stylesheet",
    "contrast",
    "accessibility",
    "oklch",
    "harmony",
    "colorblind",
    "charts",
    "dark-mode",
    "light-mode",
    "fonts",
    "ThemeProvider",
    "skia",
    "design-tokens",
    "cli"
  ],
  "author": "Saad Waheed Khan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadwaheed10/react-native-color-library.git"
  },
  "homepage": "https://github.com/saadwaheed10/react-native-color-library#readme",
  "bugs": {
    "url": "https://github.com/saadwaheed10/react-native-color-library/issues"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.60.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  }
}
